# Optional overrides — bloomgrowth-mcp has no required env vars.
# Authentication is per-request via the X-BloomGrowth-Token request header:
# a bearer access token obtained via OAuth2 Resource-Owner-Password-Credentials
# grant (POST https://app.bloomgrowth.com/Token, form-urlencoded body
# grant_type=password&userName=<email>&password=<password>). Tokens are
# valid for ~2 weeks. This server never sees the email/password — the
# caller (Agent Platform / upstream gateway) obtains and refreshes the
# token, and only the resulting bearer token is forwarded here.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
